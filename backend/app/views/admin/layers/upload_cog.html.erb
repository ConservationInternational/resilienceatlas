<%= content_for :title, "Upload COG — #{resource.name}" %>

<div class="admin-page-header">
  <h2>Upload Cloud-Optimized GeoTIFF (COG)</h2>
  <p>File uploads go directly to S3 using multipart upload. The layer's <code>layer_provider</code> will be set to <code>cog</code> and <code>layer_config.body.source</code> will be updated to the S3 URI.</p>
</div>

<% if resource.layer_provider == "cog" && resource.layer_config.present? %>
  <% cfg = begin JSON.parse(resource.layer_config) rescue {} end %>
  <% existing_uri = cfg.dig("body", "source") %>
  <% if existing_uri.present? %>
    <div class="flash flash_notice">
      Current COG URI: <code><%= existing_uri %></code>
      <br><small>Uploading a new file will replace this URI.</small>
    </div>
  <% end %>
<% end %>

<div id="uppy-dashboard-cog"></div>

<%= form_tag upload_cog_admin_layer_path(resource), method: :post, id: "cog-finalize-form" do %>
  <%= hidden_field_tag :s3_key, "", id: "cog-s3-key" %>
  <%= hidden_field_tag :file_name, "", id: "cog-file-name" %>
  <%= hidden_field_tag :file_size_bytes, "0", id: "cog-file-size" %>
  <%= submit_tag "Save COG to Layer", id: "cog-submit-btn", class: "button", disabled: true %>
<% end %>

<link rel="stylesheet" href="https://releases.transloadit.com/uppy/v3.27.3/uppy.min.css">
<script src="https://releases.transloadit.com/uppy/v3.27.3/uppy.min.js"></script>

<script>
(function() {
  const MULTIPART_BASE = "/api/v1/uploads/multipart";
  const CSRF = document.querySelector('meta[name="csrf-token"]')?.content || "";

  const uppy = new Uppy.Core({
    restrictions: { maxNumberOfFiles: 1, allowedFileTypes: [".tif", ".tiff"] }
  });

  uppy.use(Uppy.Dashboard, {
    inline: true,
    target: "#uppy-dashboard-cog",
    note: "Upload a single Cloud-Optimized GeoTIFF (.tif / .tiff)"
  });

  uppy.use(Uppy.AwsS3Multipart, {
    companionUrl: false,
    async createMultipartUpload(file) {
      const resp = await fetch(MULTIPART_BASE, {
        method: "POST",
        headers: { "Content-Type": "application/json", "X-CSRF-Token": CSRF },
        body: JSON.stringify({
          filename: file.name,
          type: file.type || "image/tiff",
          metadata: { prefix: "cogs", size: file.size }
        })
      });
      return resp.json();
    },
    async signPart(file, { uploadId, key, partNumber }) {
      const resp = await fetch(
        `${MULTIPART_BASE}/${uploadId}?key=${encodeURIComponent(key)}&partNumbers[]=${partNumber}`,
        { headers: { "X-CSRF-Token": CSRF } }
      );
      const data = await resp.json();
      return { url: data.presignedUrls[partNumber] };
    },
    async listParts() { return []; },
    async completeMultipartUpload(file, { uploadId, key, parts }) {
      const resp = await fetch(`${MULTIPART_BASE}/${uploadId}/complete`, {
        method: "POST",
        headers: { "Content-Type": "application/json", "X-CSRF-Token": CSRF },
        body: JSON.stringify({ key, parts })
      });
      return resp.json();
    },
    async abortMultipartUpload(file, { uploadId, key }) {
      await fetch(`${MULTIPART_BASE}/${uploadId}?key=${encodeURIComponent(key)}`, {
        method: "DELETE",
        headers: { "X-CSRF-Token": CSRF }
      });
    }
  });

  uppy.on("upload-success", (file, response) => {
    const key = response.uploadURL?.replace(/^s3:\/\/[^/]+\//, "") || file.meta?.key || "";
    document.getElementById("cog-s3-key").value = key;
    document.getElementById("cog-file-name").value = file.name;
    document.getElementById("cog-file-size").value = file.size;
    document.getElementById("cog-submit-btn").disabled = false;
  });
})();
</script>
