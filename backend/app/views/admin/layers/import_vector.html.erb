<%= content_for :title, "Import Vector — #{resource.name}" %>

<div class="admin-page-header">
  <h2>Import Vector Dataset</h2>
  <p>Upload a spatial file (GeoPackage, GeoJSON, or zipped Shapefile). The file will be stored in S3, then imported into PostGIS by a background job. The layer will be reconfigured for Martin tile serving.</p>
  <ul>
    <li><strong>GeoPackage (.gpkg)</strong> — preferred format</li>
    <li><strong>GeoJSON (.geojson / .json)</strong> — single file</li>
    <li><strong>Shapefile (.zip)</strong> — zip all components (.shp, .dbf, .prj, etc.) into a single ZIP archive</li>
  </ul>
  <p>The imported table will be named <code>imported_<%= resource.slug.gsub(/[^a-z0-9_]/, "_") %></code> in the <code>ra_vector</code> schema.</p>
</div>

<% pending_imports = DataImport.where(importable: resource, import_type: "vector").order(created_at: :desc).limit(3) %>
<% if pending_imports.any? %>
  <div class="panel">
    <h3>Recent Import Jobs</h3>
    <table>
      <thead><tr><th>ID</th><th>Date</th><th>File</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% pending_imports.each do |di| %>
          <tr>
            <td><%= di.id %></td>
            <td><%= di.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td><%= di.file_name %></td>
            <td><span class="status_tag status_<%= di.status %>"><%= di.status %></span></td>
            <td><%= link_to "Details", admin_data_import_path(di) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<div id="uppy-dashboard-vector"></div>

<%= form_tag import_vector_admin_layer_path(resource), method: :post, id: "vector-finalize-form" do %>
  <%= hidden_field_tag :s3_key, "", id: "vector-s3-key" %>
  <%= hidden_field_tag :file_name, "", id: "vector-file-name" %>
  <%= hidden_field_tag :file_size_bytes, "0", id: "vector-file-size" %>
  <%= submit_tag "Queue Import Job", id: "vector-submit-btn", class: "button", disabled: true %>
<% end %>

<link rel="stylesheet" href="https://releases.transloadit.com/uppy/v3.27.3/uppy.min.css">
<script src="https://releases.transloadit.com/uppy/v3.27.3/uppy.min.js"></script>

<script>
(function() {
  const MULTIPART_BASE = "/api/v1/uploads/multipart";
  const CSRF = document.querySelector('meta[name="csrf-token"]')?.content || "";
  const ALLOWED = [".gpkg", ".geojson", ".json", ".zip"];

  const uppy = new Uppy.Core({
    restrictions: { maxNumberOfFiles: 1, allowedFileTypes: ALLOWED }
  });

  uppy.use(Uppy.Dashboard, {
    inline: true,
    target: "#uppy-dashboard-vector",
    note: "Upload a GeoPackage, GeoJSON, or zipped Shapefile"
  });

  uppy.use(Uppy.AwsS3Multipart, {
    companionUrl: false,
    async createMultipartUpload(file) {
      const resp = await fetch(MULTIPART_BASE, {
        method: "POST",
        headers: { "Content-Type": "application/json", "X-CSRF-Token": CSRF },
        body: JSON.stringify({
          filename: file.name,
          type: file.type || "application/octet-stream",
          metadata: { prefix: "staging", size: file.size }
        })
      });
      return resp.json();
    },
    async signPart(file, { uploadId, key, partNumber }) {
      const resp = await fetch(
        `${MULTIPART_BASE}/${uploadId}?key=${encodeURIComponent(key)}&partNumbers[]=${partNumber}`,
        { headers: { "X-CSRF-Token": CSRF } }
      );
      const data = await resp.json();
      return { url: data.presignedUrls[partNumber] };
    },
    async listParts() { return []; },
    async completeMultipartUpload(file, { uploadId, key, parts }) {
      const resp = await fetch(`${MULTIPART_BASE}/${uploadId}/complete`, {
        method: "POST",
        headers: { "Content-Type": "application/json", "X-CSRF-Token": CSRF },
        body: JSON.stringify({ key, parts })
      });
      return resp.json();
    },
    async abortMultipartUpload(file, { uploadId, key }) {
      await fetch(`${MULTIPART_BASE}/${uploadId}?key=${encodeURIComponent(key)}`, {
        method: "DELETE",
        headers: { "X-CSRF-Token": CSRF }
      });
    }
  });

  uppy.on("upload-success", (file, response) => {
    const key = response.uploadURL?.replace(/^s3:\/\/[^/]+\//, "") || file.meta?.key || "";
    document.getElementById("vector-s3-key").value = key;
    document.getElementById("vector-file-name").value = file.name;
    document.getElementById("vector-file-size").value = file.size;
    document.getElementById("vector-submit-btn").disabled = false;
  });
})();
</script>
